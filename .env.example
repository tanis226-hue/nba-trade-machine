# Copy to .env.local and fill from your Supabase project settings (gitignored).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only, used by scripts/import.ts and the API route. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
