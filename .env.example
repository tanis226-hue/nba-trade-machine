# No variables are required for a local demo using the bundled snapshot.
# Copy to .env.local only when connecting services. Never commit credentials.

# Optional Neon Postgres; server-only. NETLIFY_DATABASE_URL is also supported.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional accounts. Set BOTH keys to enable Clerk.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Ad placeholders are disabled by default.
NEXT_PUBLIC_ADS_ENABLED=false
